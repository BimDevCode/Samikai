{
    "profiles": {
        "http": {
            "commandName": "Project",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5223"
            }
        },
        "Container (Dockerfile)": {
            "commandName": "Docker",
